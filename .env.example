PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_NAME=Portfolio Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-password
# Optional for separate frontend hosting. Leave blank for same-origin deployment.
FRONTEND_ORIGINS=
# For a separately hosted frontend, use a full HTTPS API prefix ending in /api.
# Set VITE_API_URL at frontend build time, not as a secret.
